{
  "name": "@coord/<%= name %>",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {},<% if (usesReact) { %>
  "peerDependencies": {
    "react": "19.3.0"<% if (platform === 'dom') { %>,
    "react-dom": "19.3.0"<% } %>
  },<% } %>
  "devDependencies": {<% if (usesNode) { %>
    "@types/node": "^24",<% } %><% if (usesReact) { %>
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "jsdom": "30.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",<% } %>
    "@coord/tsconfig": "workspace:*",
    "typescript": "~6.0.3"
  },
  "nx": {
    "tags": ["type:<%= type %>", "platform:<%= platform %>"]
  }
}
