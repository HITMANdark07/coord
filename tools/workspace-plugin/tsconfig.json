{
  "extends": "@coord/tsconfig/node.json",
  "compilerOptions": {
    // Nx 24 runs this plugin with Node's native TypeScript stripping: ESM with explicit .ts imports.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src"],
  "exclude": ["src/generators/*/files"]
}
