{
  "compilerOptions": {
    "target": "ES2023",
    // DOM types give us the globals every runtime has (fetch, AbortSignal, URL, timers).
    // Browser-only globals and Node built-ins are banned in cross-platform packages by lint (eslint.config.mjs).
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  }
}
